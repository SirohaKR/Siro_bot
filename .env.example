# 디스코드 개발자 포털(discord.com/developers)에서 발급받은 봇 토큰을 여기에 붙여넣으세요.
# 이 파일을 복사해서 이름을 ".env"로 바꾼 뒤(점으로 시작), 실제 값을 채워넣으면 됩니다.
# main.py(봇)와 web/app.py(설정 페이지)가 이 토큰을 함께 사용합니다.
DISCORD_TOKEN=여기에_봇_토큰_붙여넣기

# 웹 설정 페이지 (web/app.py) 관련 값
# WEB_ADMIN_TOKEN: 페이지 접속용 비밀번호 역할. 아무 문자열이나 길고 추측 어렵게 지어서 넣으세요.
#   접속은 http://서버주소:포트/?token=여기값 형태로 합니다.
WEB_ADMIN_TOKEN=change-me-to-a-random-secret
FLASK_SECRET_KEY=change-me-too
WEB_PORT=5000

# WEB_PUBLIC_URL: 설정 페이지를 실제로 여는 외부 주소 (포트 포함, 맨 끝에 / 없이).
# 디스코드에서 "/설정" 명령어를 치면 이 주소 + 토큰을 조합해서 알려준다.
# 예: WEB_PUBLIC_URL=http://exdrone.synology.me:5051
WEB_PUBLIC_URL=

# MY_GUILD_ID: 길드 서버의 ID. 적어두면 슬래시 명령어(/설정 등)가 디스코드 쪽 캐시
# 지연(최대 1시간) 없이 그 서버에는 바로 뜬다. 안 적어도 언젠가는 뜨지만 느리다.
# 구하는 법: 디스코드 앱 → 설정 → 고급 → "개발자 모드" 켜기 → 서버 아이콘 우클릭 →
# "서버 ID 복사"
MY_GUILD_ID=

# AWS Polly TTS (선택 — 유료, 안 쓰면 비워둬도 무료 edge-tts만 동작함)
# IAM에서 "AmazonPollyReadOnlyAccess" 권한만 있는 사용자를 만들어 발급받은 값.
# AWS_REGION은 비워두면 서울 리전(ap-northeast-2)을 기본으로 씀.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-northeast-2

# 타입캐스트 TTS (선택 — 유료, 안 쓰면 비워둬도 무료 edge-tts만 동작함)
# typecast.ai에서 회원가입 후 발급받은 API 키. https://typecast.ai/docs/ko/quickstart
TYPECAST_API_KEY=
